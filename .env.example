# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env && chmod 600 .env

# themoviedb.org — years, descriptions and release dates
TMDB_API_KEY=
TMDB_READ_TOKEN=

# developer.spotify.com/dashboard — playlist read and write
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# written by `python spotify_sync.py --auth`; do not paste one by hand
SPOTIFY_REFRESH_TOKEN=

# last.fm/api — track tags for the vibe classifier. Read-only calls need the
# key alone, so the shared secret is deliberately not stored here.
LASTFM_API_KEY=

# --- machine-specific, not secrets -------------------------------------------
# setup.sh warns if the first one is missing; nothing warns about the second
# until Vite refuses the request.

# Origin for every distance in the app: the Tonight radius filter and the
# /dates km column both measure from it. Unset, it is 0,0.
# LEDGER_HOME_LATLON="48.8566,2.3522"

# The tailnet name this machine answers to. rxconfig.py asks tailscale when
# this is unset; set it for a MagicDNS alias or a reverse proxy.
# LEDGER_ALLOWED_HOST="<host>.<tailnet>.ts.net"

# The two people voting on the want-to-try columns, lowercase, comma separated.
# They are stored with every vote, so renaming one later orphans their votes.
# LEDGER_PEOPLE="alex,sam"
