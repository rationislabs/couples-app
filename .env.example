# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env && chmod 600 .env

# --- required ------------------------------------------------------------------
# Tailscale admin console > Settings > Keys > Generate auth key.
# Not ephemeral (the container must keep its identity across restarts).
TS_AUTHKEY=
# The app's full name on YOUR tailnet: <TS_HOSTNAME>.<your-tailnet>.ts.net
# (admin console > DNS shows the tailnet name). The app answers only pages
# served from this name, so nothing else on the web can drive it.
LEDGER_ALLOWED_HOST=

# --- optional ------------------------------------------------------------------
# The app's name on your tailnet: https://<this>.<your-tailnet>.ts.net
# TS_HOSTNAME=couples
# Pin a version instead of following :latest. Rolling back: see the README.
# COUPLES_VERSION=0.1.0
# Times and dates, including when the nightly backup runs.
TZ=UTC
# LEDGER_BACKUP_AT=03:30
# LEDGER_BACKUP_KEEP=30

# --- optional integrations -----------------------------------------------------
# themoviedb.org: years, descriptions and release dates
TMDB_API_KEY=
TMDB_READ_TOKEN=
# developer.spotify.com/dashboard: playlist read and write. The one-time
# `spotify_sync.py --auth` needs a browser, so run it on a machine with one
# (README, "Spotify").
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=
# last.fm/api: track tags for the vibe classifier. Read-only calls need the key alone.
LASTFM_API_KEY=

